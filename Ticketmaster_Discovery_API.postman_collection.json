{
  "info": {
    "name": "Ticketmaster Discovery API - Events App",
    "_postman_id": "b3f0a1d2-1234-4abc-9def-ticketmasterapp",
    "description": "Collection matching the Events App UI:\n- Home (Categories, Upcoming Events, Nearby Events)\n- Search & Filter\n- See All Events / Events List\n- Event Details\n- Empty State (no extra call needed, handled client-side)\n\nBase URL: https://app.ticketmaster.com/discovery/v2\nAuth: apikey query param (set in collection variables)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "https://app.ticketmaster.com/discovery/v2" },
    { "key": "apikey", "value": "YOUR_API_KEY" },
    { "key": "countryCode", "value": "GB" },
    { "key": "city", "value": "London" },
    { "key": "latlong", "value": "40.7484,-73.9857" },
    { "key": "eventId", "value": "G5diZfkn0B-bh" }
  ],
  "item": [
    {
      "name": "1. Home",
      "item": [
        {
          "name": "1.1 Categories (Sports / Music / Art / Food)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/classifications.json?apikey={{apikey}}",
              "host": ["{{baseUrl}}"],
              "path": ["classifications.json"],
              "query": [
                { "key": "apikey", "value": "{{apikey}}" }
              ]
            },
            "description": "Maps to: Home screen category pills (Sports, Music, Art, Food...).\nUsed to populate the horizontal category/segment selector."
          }
        },
        {
          "name": "1.2 Upcoming Events (Home carousel)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/events.json?apikey={{apikey}}&city={{city}}&sort=date,asc&size=10",
              "host": ["{{baseUrl}}"],
              "path": ["events.json"],
              "query": [
                { "key": "apikey", "value": "{{apikey}}" },
                { "key": "city", "value": "{{city}}" },
                { "key": "sort", "value": "date,asc" },
                { "key": "size", "value": "10" }
              ]
            },
            "description": "Maps to: Home > 'Upcoming Events' horizontal cards (e.g. International Band Music, Jo Malone). Sorted by soonest date."
          }
        },
        {
          "name": "1.3 Nearby Events (geo)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/events.json?apikey={{apikey}}&latlong={{latlong}}&radius=20&unit=km&sort=distance,asc&size=10",
              "host": ["{{baseUrl}}"],
              "path": ["events.json"],
              "query": [
                { "key": "apikey", "value": "{{apikey}}" },
                { "key": "latlong", "value": "{{latlong}}" },
                { "key": "radius", "value": "20" },
                { "key": "unit", "value": "km" },
                { "key": "sort", "value": "distance,asc" },
                { "key": "size", "value": "10" }
              ]
            },
            "description": "Maps to: Home > 'Nearby You' section. Uses device lat/long + radius. Note: 'latlong' is deprecated in favor of 'geoPoint' (geohash) - swap if needed."
          }
        }
      ]
    },
    {
      "name": "2. Search",
      "item": [
        {
          "name": "2.1 Search by Keyword",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/events.json?apikey={{apikey}}&keyword=jazz&size=20",
              "host": ["{{baseUrl}}"],
              "path": ["events.json"],
              "query": [
                { "key": "apikey", "value": "{{apikey}}" },
                { "key": "keyword", "value": "jazz" },
                { "key": "size", "value": "20" }
              ]
            },
            "description": "Maps to: Search screen results list (typing into the search bar)."
          }
        },
        {
          "name": "2.2 Search with Filters (category, date, location, price)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/events.json?apikey={{apikey}}&classificationName=music&city={{city}}&startDateTime=2026-06-16T00:00:00Z&endDateTime=2026-06-16T23:59:59Z&size=20&sort=date,asc",
              "host": ["{{baseUrl}}"],
              "path": ["events.json"],
              "query": [
                { "key": "apikey", "value": "{{apikey}}" },
                { "key": "classificationName", "value": "music", "description": "From category pills: Sports/Music/Art/Food" },
                { "key": "city", "value": "{{city}}", "description": "From Location field" },
                { "key": "startDateTime", "value": "2026-06-16T00:00:00Z", "description": "From Time & Date (e.g. 'Tomorrow')" },
                { "key": "endDateTime", "value": "2026-06-16T23:59:59Z" },
                { "key": "size", "value": "20" },
                { "key": "sort", "value": "date,asc" }
              ]
            },
            "description": "Maps to: Filter modal (Sports/Music/Art/Food/Film tabs + Time&Date + Location + Price range) applied to the Search screen.\n\nNOTE: The Discovery API has NO native price-range query filter for $20-$120 sliders. priceRanges are returned per event in the response, so the price slider must be applied as a CLIENT-SIDE post-filter on the results."
          }
        }
      ]
    },
    {
      "name": "3. See All Events / Events List",
      "item": [
        {
          "name": "3.1 Get All Events (Upcoming tab)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/events.json?apikey={{apikey}}&city={{city}}&sort=date,asc&size=20&page=0",
              "host": ["{{baseUrl}}"],
              "path": ["events.json"],
              "query": [
                { "key": "apikey", "value": "{{apikey}}" },
                { "key": "city", "value": "{{city}}" },
                { "key": "sort", "value": "date,asc" },
                { "key": "size", "value": "20" },
                { "key": "page", "value": "0" }
              ]
            },
            "description": "Maps to: 'See All Events' from Home, and Events screen 'UPCOMING' tab. Same endpoint as Upcoming Events, just paginated full list."
          }
        },
        {
          "name": "3.2 Get Past Events",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/events.json?apikey={{apikey}}&city={{city}}&endDateTime=2026-06-15T00:00:00Z&sort=date,desc&size=20",
              "host": ["{{baseUrl}}"],
              "path": ["events.json"],
              "query": [
                { "key": "apikey", "value": "{{apikey}}" },
                { "key": "city", "value": "{{city}}" },
                { "key": "endDateTime", "value": "2026-06-15T00:00:00Z", "description": "End date before today = past events" },
                { "key": "sort", "value": "date,desc" },
                { "key": "size", "value": "20" }
              ]
            },
            "description": "Maps to: Events screen 'PAST EVENTS' tab. Discovery API doesn't have a native 'past events' flag - filter by endDateTime before now and sort desc."
          }
        }
      ]
    },
    {
      "name": "4. Event Details",
      "item": [
        {
          "name": "4.1 Get Event Details by ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/events/{{eventId}}.json?apikey={{apikey}}",
              "host": ["{{baseUrl}}"],
              "path": ["events", "{{eventId}}.json"],
              "query": [
                { "key": "apikey", "value": "{{apikey}}" }
              ]
            },
            "description": "Maps to: Event Details screen (title, date, venue, organizer/attraction, description, price -> BUY TICKET button uses the 'url' field from response)."
          }
        },
        {
          "name": "4.2 Get Event Images",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/events/{{eventId}}/images.json?apikey={{apikey}}",
              "host": ["{{baseUrl}}"],
              "path": ["events", "{{eventId}}", "images.json"],
              "query": [
                { "key": "apikey", "value": "{{apikey}}" }
              ]
            },
            "description": "Maps to: Event Details screen hero image / gallery (optional, the events.json response already includes an 'images' array, this gives extra sizes/ratios)."
          }
        }
      ]
    }
  ]
}
